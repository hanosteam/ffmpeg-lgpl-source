+        if (obu_size != 0)
+            return 0;
+    } else if (type == AV1_OBU_SEQUENCE_HEADER) {
+        // A leading Sequence Header also starts a temporal unit.
+        seq = 1;
+    } else {
         return 0;
+    }
 
     while (1) {
         ret = read_obu_with_size(p->buf + cnt, p->buf_size - cnt, &obu_size, &type);
